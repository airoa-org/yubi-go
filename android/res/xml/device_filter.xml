<?xml version="1.0" encoding="utf-8"?>
<resources>
  <!-- Android matches `class` against the device and each of its interfaces,
       so this takes every UVC webcam. -->
  <usb-device class="14"/>
  <!-- The gripper encoder: an ESP32-C6's USB-Serial/JTAG, 303a:1001 in
       meta.json. Decimal, as the attributes are written. -->
  <usb-device vendor-id="12346" product-id="4097"/>
</resources>
