<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.airoa.yubigo"
    android:versionCode="1"
    android:versionName="0.1.0">

  <uses-feature android:name="android.hardware.usb.host" android:required="true"/>
  <!-- view::gl makes an ES 3.0 context; Meta's upload check wants one declared. -->
  <uses-feature android:glEsVersion="0x00030000" android:required="true"/>
  <!-- Declares an immersive VR app; Meta's runtime only offers passthrough
       and other FB extensions to apps that do. -->
  <uses-feature android:name="android.hardware.vr.headtracking" android:required="true" android:version="1"/>
  <uses-feature android:name="com.oculus.feature.PASSTHROUGH" android:required="true"/>
  <!-- Passthrough app: the user sees the room, so no boundary is required. -->
  <uses-feature android:name="com.oculus.feature.BOUNDARYLESS_APP" android:required="true"/>
  <!-- Horizon OS requires both to open USB video-class devices (sensors::usb). -->
  <uses-permission android:name="android.permission.CAMERA"/>
  <uses-permission android:name="horizonos.permission.USB_CAMERA"/>
  <!-- stream::mdns holds a MulticastLock, or Android drops every mDNS query. -->
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <!-- No HEADSET_CAMERA or SPATIAL_CAMERA. The headset's own stereo camera
       needs the `hzos.app.role.SPATIAL_CAMERA` role, and Horizon OS v207
       grants that role only to `com.oculus.*` packages. The head camera is a
       USB webcam (`hub::SLOT_HEAD`), so it opens on CAMERA like the wrists. -->

  <application
      android:label="YUBI Go"
      android:hasCode="false"
      android:usesCleartextTraffic="true"
      android:extractNativeLibs="true">
    <!-- `hasCode` is false: there is no Java in this APK and no classes.dex.

         `usesCleartextTraffic` has no effect here. It governs the Java
         network stack, and every request this app makes goes through native
         sockets. -->
    <!-- Tells Horizon OS this is an immersive VR app, not a 2D panel.
         Without it the shell resumes the activity in a panel and the
         OpenXR session never leaves IDLE. -->
    <meta-data android:name="com.samsung.android.vr.application.mode" android:value="vr_only"/>
    <meta-data android:name="com.oculus.supportedDevices" android:value="quest3|quest3s"/>
    <activity
        android:name="android.app.NativeActivity"
        android:exported="true"
        android:screenOrientation="landscape"
        android:launchMode="singleTask"
        android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|mcc|mnc|navigation|orientation|screenLayout|screenSize|smallestScreenSize|touchscreen|uiMode"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen">
      <meta-data android:name="android.app.lib_name" android:value="yubi_go"/>
      <!-- Without this the Horizon shell never hands VR display focus to the
           app and the OpenXR session stays in IDLE forever. -->
      <meta-data android:name="com.oculus.vr.focusaware" android:value="true"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
        <category android:name="com.oculus.intent.category.VR"/>
      </intent-filter>
      <!-- On attach, Android starts the app for a device that matches the filter
           below and grants it USB permission for that device, so the app does
           not have to ask at run time. A hub replug starts it through here too. -->
      <intent-filter>
        <action android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"/>
      </intent-filter>
      <meta-data
          android:name="android.hardware.usb.action.USB_DEVICE_ATTACHED"
          android:resource="@xml/device_filter"/>
    </activity>
  </application>
</manifest>
