<?xml version="1.0"?>
<!-- Expanded by hand from airoa-org/yubi-sw yubi_description/urdf/yubi_hand.urdf.xacro
     (collision geometry dropped; mesh paths point at package://yubi_description/meshes) -->
<robot name="yubi_hands">
  <material name="yubi_gray">
    <color rgba="1.0 1.0 1.0 1"/>
  </material>

  <link name="quest_origin"/>
  <link name="quest_right_controller"/>
  <link name="quest_left_controller"/>

  <!-- right hand -->
  <link name="right_hand_root">
    <visual>
      <origin xyz="-0.022 0 -0.02015" rpy="0 0 0"/>
      <geometry><box size="0.044 0.067 0.0735"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="right_camera_joint" type="fixed">
    <origin xyz="0 0 0.0426" rpy="0 0 0"/>
    <parent link="right_hand_root"/>
    <child link="right_hand_cam_link"/>
  </joint>
  <link name="right_hand_cam_link">
    <visual>
      <origin xyz="-0.0175 0 0" rpy="0 0 0"/>
      <geometry><box size="0.035 0.032 0.042"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="right_right_finger_joint" type="revolute">
    <origin xyz="-0.016 -0.015 0" rpy="0 0 0"/>
    <parent link="right_hand_root"/>
    <child link="right_right_finger_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.00" upper="0.94" effort="5" velocity="2"/>
  </joint>
  <link name="right_right_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://yubi_description/meshes/yubi/hand_right_right_finger_link.STL"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="right_right_finger_tip_joint" type="fixed">
    <origin xyz="0.10943 -0.014 0" rpy="0 0 0"/>
    <parent link="right_right_finger_link"/>
    <child link="right_right_finger_tip_link"/>
  </joint>
  <link name="right_right_finger_tip_link"/>
  <joint name="right_left_finger_joint" type="revolute">
    <origin xyz="-0.016 0.015 0" rpy="0 0 0"/>
    <parent link="right_hand_root"/>
    <child link="right_left_finger_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.94" upper="0.00" effort="5" velocity="2"/>
    <mimic joint="right_right_finger_joint" multiplier="-1" offset="0"/>
  </joint>
  <link name="right_left_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://yubi_description/meshes/yubi/hand_right_left_finger_link.STL"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="right_left_finger_tip_joint" type="fixed">
    <origin xyz="0.10943 0.014 0" rpy="0 0 0"/>
    <parent link="right_left_finger_link"/>
    <child link="right_left_finger_tip_link"/>
  </joint>
  <link name="right_left_finger_tip_link"/>

  <!-- left hand -->
  <link name="left_hand_root">
    <visual>
      <origin xyz="-0.022 0 -0.02015" rpy="0 0 0"/>
      <geometry><box size="0.044 0.067 0.0735"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="left_camera_joint" type="fixed">
    <origin xyz="0 0 0.0426" rpy="0 0 0"/>
    <parent link="left_hand_root"/>
    <child link="left_hand_cam_link"/>
  </joint>
  <link name="left_hand_cam_link">
    <visual>
      <origin xyz="-0.0175 0 0" rpy="0 0 0"/>
      <geometry><box size="0.035 0.032 0.042"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="left_right_finger_joint" type="revolute">
    <origin xyz="-0.016 -0.015 0" rpy="0 0 0"/>
    <parent link="left_hand_root"/>
    <child link="left_right_finger_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="0.00" upper="0.94" effort="5" velocity="2"/>
  </joint>
  <link name="left_right_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://yubi_description/meshes/yubi/hand_left_right_finger_link.STL"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="left_right_finger_tip_joint" type="fixed">
    <origin xyz="0.10943 -0.014 0" rpy="0 0 0"/>
    <parent link="left_right_finger_link"/>
    <child link="left_right_finger_tip_link"/>
  </joint>
  <link name="left_right_finger_tip_link"/>
  <joint name="left_left_finger_joint" type="revolute">
    <origin xyz="-0.016 0.015 0" rpy="0 0 0"/>
    <parent link="left_hand_root"/>
    <child link="left_left_finger_link"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.94" upper="0.00" effort="5" velocity="2"/>
    <mimic joint="left_right_finger_joint" multiplier="-1" offset="0"/>
  </joint>
  <link name="left_left_finger_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><mesh filename="package://yubi_description/meshes/yubi/hand_left_left_finger_link.STL"/></geometry>
      <material name="yubi_gray"/>
    </visual>
  </link>
  <joint name="left_left_finger_tip_joint" type="fixed">
    <origin xyz="0.10943 0.014 0" rpy="0 0 0"/>
    <parent link="left_left_finger_link"/>
    <child link="left_left_finger_tip_link"/>
  </joint>
  <link name="left_left_finger_tip_link"/>

  <joint name="quest_origin_to_left" type="floating">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="quest_origin"/>
    <child link="left_hand_root"/>
  </joint>
  <joint name="quest_origin_to_right" type="floating">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="quest_origin"/>
    <child link="right_hand_root"/>
  </joint>
  <joint name="right_mount_joint" type="fixed">
    <origin xyz="-0.063 -0.016 0.0525" rpy="0 -0.7853981633974483 -0.7853981633974483"/>
    <parent link="right_hand_root"/>
    <child link="quest_right_controller"/>
  </joint>
  <joint name="left_mount_joint" type="fixed">
    <origin xyz="-0.063 0.016 0.0525" rpy="0 -0.7853981633974483 0.7853981633974483"/>
    <parent link="left_hand_root"/>
    <child link="quest_left_controller"/>
  </joint>
</robot>
